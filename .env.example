# Google Gemini API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Postgres connection string (Neon free tier). Leave empty locally to use an embedded PGlite database.
DATABASE_URL=

# Local embedded database directory (used only when DATABASE_URL is empty)
PGLITE_DIR=.data/pglite

# "mock" = deterministic AI for tests/offline dev (refused on Vercel)
AI_PROVIDER=gemini
